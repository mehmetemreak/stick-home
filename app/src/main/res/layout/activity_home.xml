<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/top_right_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="48dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8FEBFF"
            android:textSize="13sp"
            android:shadowColor="#B0000000"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stick Home"
            android:textColor="#CCFFFFFF"
            android:shadowColor="#B0000000"
            android:shadowRadius="6"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#99FFFFFF"
            android:shadowColor="#B0000000"
            android:shadowRadius="6"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/weather_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#77FFFFFF"
            android:shadowColor="#B0000000"
            android:shadowRadius="6"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcoming_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="48dp"
        android:orientation="vertical" />

    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/reveal_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="⌄"
            android:textColor="#77FFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/chips_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/shelf_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_bar"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="0dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/app_shelf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </HorizontalScrollView>

</RelativeLayout>
